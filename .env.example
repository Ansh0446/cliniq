# ── Browser (public values; protected by RLS) ──────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
# Public address of the deployed site, https, no trailing slash. Needed for social previews and canonical links.
VITE_SITE_URL=https://your-domain.example
# Shown in the privacy policy and terms.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
VITE_GRIEVANCE_EMAIL=
# Set to true only after a lawyer has reviewed the privacy policy and terms (hides the draft notice).
VITE_LEGAL_REVIEWED=false
# Optional analytics (Plausible-compatible script). Loads only after opt-in, on public pages only.
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.exclusions.js
# VITE_ANALYTICS_DOMAIN=your-domain.example
# Optional CAPTCHA (Cloudflare Turnstile). Also enable CAPTCHA in Supabase Auth with the secret.
# VITE_TURNSTILE_SITE_KEY=

# ── Server only (never prefix with VITE_) ──────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
GEMINI_API_KEY=YOUR-GEMINI-KEY
# Verify the exact model ID in Google AI Studio before deploying
GEMINI_MODEL=gemini-2.5-flash
# Signs AI output so doctors can detect tampering. 32+ random characters. If empty, derived from GEMINI_API_KEY.
AI_SIGNING_SECRET=
# Security headers: report-only (default) | enforce | off. Switch to enforce after checking the browser console.
CSP_MODE=report-only
# Redirect http to https in production. Set to false only for a plain-http test.
# FORCE_HTTPS=false
# Optional: your own Overpass / Nominatim instances, or an override of the public address used in sitemap.xml
# OVERPASS_URL=
# NOMINATIM_URL=
# SITE_URL=
